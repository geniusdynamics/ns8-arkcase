# Generate the MariaDB passwords in a 0600 state file

import os
import secrets

path = os.path.join(os.environ.get("AGENT_STATE_DIR", "."), "passwords.env")
if not os.path.exists(path):  # clone and restore keep their file
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(f"MARIADB_ROOT_PASSWORD={secrets.token_hex(16)}\n")
        f.write(f"MARIADB_PASSWORD={secrets.token_hex(16)}\n")
